# Caddy configuration for the riff image behind a TLS-terminating edge
# proxy (Fly.io) when the host serves TWO things: the baked-in static site
# at the ROOT, and the riff SPA + Connect/gRPC surface under /memos/.
#
# This is the inverse of scripts/Caddyfile.fly, which mounts riff at the
# root and treats /memos/* as a back-compat alias. That layout
# assumes the operator wants riff to own the hostname; this one assumes
# the static site is the primary content and riff is one of several
# sub-apps. The two files share a common ancestor in the ACME variant
# (scripts/Caddyfile), where the host matcher picks the public DNS name
# and /memos/* is a normal path-prefix reverse-proxy.
#
# Why a third file instead of inverting the existing one:
#   * scripts/Caddyfile.fly is documented in three places (its own header,
#     fly.toml, AGENTS.md) as "SPA at the root". Changing its meaning
#     would silently break that contract.
#   * Keeping a separate file makes the deploy intent explicit
#     (CADDYFILE=Caddyfile.fly.community in fly.toml) and a one-env-var
#     rollback target.
#
# Layout (all on :80 - Fly's edge terminates TLS, see fly.toml):
#
#   https://<host>/                         ->  static site at /var/www/site/
#   https://<host>/youtube/*                ->  the user-facing download
#                                                tree at /youtube/ (a
#                                                separate directory from
#                                                the static site; the
#                                                operator drops files in
#                                                it to publish downloads)
#   https://<host>/memos/*                  ->  the Memos SPA + Connect
#                                                surface, on riff at
#                                                127.0.0.1:8090 (prefix
#                                                stripped by handle_path
#                                                so riff sees its normal
#                                                paths)
#   https://<host>/community/*              ->  308 to /memos/* (the
#                                                prefix this layout used
#                                                to serve, kept so old
#                                                bookmarks land)
#   https://<host>/wiki/*                  ->  the wiki module, ALSO on
#                                                riff, but at the SAME
#                                                level as /memos/ (a
#                                                sibling, not a child).
#                                                The path is NOT rewritten:
#                                                riff mounts the wiki at
#                                                /wiki internally, so the
#                                                prefix must reach it.
#   https://<host>/forum/*                 ->  the forum module, ALSO on
#                                                riff, a sibling of
#                                                /memos/ and /wiki/.
#                                                The path is NOT rewritten,
#                                                for the same reason: riff
#                                                mounts the forum at /forum
#                                                internally and the SPA
#                                                builds absolute /forum/...
#                                                URLs.
#   https://<host>/_/...                    ->  the PocketBase dashboard,
#                                                on riff, path VERBATIM
#   https://<host>/api/...                  ->  the PocketBase REST API,
#                                                on riff, path VERBATIM
#   https://<host>/mcp                      ->  riff's MCP endpoint, on
#                                                riff, path VERBATIM
#                                                (it answers /mcp/ too)
#   https://<host>/memos (no slash)         ->  308 redirect to /memos/
#                                                so the SPA never boots
#                                                against a parent-only URL
#   https://<host>/<spa-path>               ->  308 to /memos/<spa-path>
#                                                so a root-prefixed SPA URL
#                                                (e.g. /auth, /u/peter)
#                                                doesn't 404 against the
#                                                static site's file_server.
#                                                The query string is
#                                                preserved by the {uri}
#                                                placeholder, so a URL
#                                                like /auth?redirect=%2F
#                                                lands as
#                                                /memos/auth?redirect=%2F
#                                                and the SPA picks up the
#                                                intent. {path} would lose
#                                                the query string, which is
#                                                why {uri} is the right
#                                                choice here.
#                                                Excluded are the static
#                                                site's own paths (so a
#                                                future /blog under the
#                                                static site still serves
#                                                as itself, not as a
#                                                SPA redirect) and the
#                                                /memos/* tree
#                                                (covered by handle_path
#                                                below, not by this block).
#   anything else (e.g. a typo)             ->  404 (file_server misses)
#
# The riff SPA is built with VITE_BASE_PATH=/memos/ pnpm release so the
# emitted asset URLs and the connect-web baseUrl resolve under /memos/
# (see web/vite.config.mts and web/src/connect.ts). `/community/` is a
# 308 redirect to it: the SPA is built for exactly ONE base path, so a
# second prefix cannot serve the same bundle. The
# static site is whatever the ravine build context contains - today
# the Jekyll _site/ tree at /home/peter/CLionProjects/ravine.1une.cc.
#
# Same X-Forwarded-* contract as scripts/Caddyfile.fly: replace-and-append
# the client IP and pin X-Forwarded-Proto to https so PocketBase's
# trusted-proxy resolver, the rate limiter, the email link builder, and
# the Secure cookie flag all see the public origin.

(proxy) {
	reverse_proxy 127.0.0.1:8090 {
		header_up X-Forwarded-For "{http.request.header.X-Forwarded-For}, {remote_host}"
		header_up X-Forwarded-Proto https
	}
}

:80 {
	encode zstd gzip

	# Caddy evaluates handle blocks in declaration order; the first
	# matcher that matches wins. We declare seven, in this order:
	#   1. exact /memos         -> 308 to /memos/, so the SPA's
	#                               relative URL resolution finds
	#                               /memos/assets/... instead of
	#                               /assets/... (which would hit the
	#                               static site).
	#   2. /memos/*             -> reverse_proxy to riff (prefix
	#                               stripped by handle_path).
	#   2a. /community, /community/* -> 308 to /memos/... (the
	#                               prefix this layout used to
	#                               serve).
	#   3. SPA-only paths        -> 308 to /memos/<path>, so a
	#                               root-prefixed SPA URL doesn't 404
	#                               against the static site's
	#                               file_server. Excluded are paths
	#                               the static site already serves
	#                               (so a new /blog under the static
	#                               site still answers as itself, not
	#                               as a SPA redirect).
	#   4. /youtube/*            -> file_server for the user-facing
	#                               download tree.
	#   5. anything else         -> file_server for the static site.
	#
	# The bare-`handle` at the end is a catch-all and is evaluated
	# only when the previous four blocks do not match. Putting
	# `redir` outside any `handle` block would be evaluated AFTER
	# the catch-all and never see the request, because file_server
	# would already have served a 404 for /memos (no trailing
	# slash, no matching file in /var/www/site).

	# 1. /memos (no trailing slash) -> 308 to /memos/, so the SPA's
	# relative URL resolution finds /memos/assets/... instead of
	# /assets/... (which would hit the static site).
	handle /memos {
		redir * /memos/ 308
	}

	# 2. /memos/*: the Memos SPA + Connect/gRPC surface.
	# handle_path strips the /memos prefix before forwarding, so the
	# requests riff sees are its normal /, /_/, /api/health, /mcp,
	# /memos.api.v1.*, etc.
	#
	# The strip is load-bearing: the SPA is built with
	# `VITE_BASE_PATH=/memos/ pnpm release`, so it emits
	# /memos/assets/index-*.js. Without the strip riff would answer
	# that with its own SPA fallback — index.html served as
	# JavaScript — and the app would never boot.
	handle_path /memos/* {
		import proxy
	}

	# 2a. /community: this layout's prefix before the SPA moved to
	# /memos/. It is a 308 rather than a second proxy: the SPA is
	# built for exactly one base path, so a request under /community/
	# would load a shell whose asset URLs point at /memos/.
	#
	# {uri} carries the query string (e.g.
	# /community/auth?redirect=%2F), which {path} would drop.
	handle /community {
		redir * /memos/ 308
	}
	# handle_path strips /community BEFORE the block runs, so {uri} is
	# already the remainder: /community/auth -> /memos/auth. A plain
	# `handle` would leave the prefix in {uri} and produce
	# /memos/community/auth, which is the bug this form exists to avoid.
	handle_path /community/* {
		redir * /memos{uri} 308
	}

	# 2b. /wiki/*: the wiki module, mounted by riff at /wiki INSIDE the
	# listener. The path therefore has to reach it unchanged — this
	# block uses `handle`, NOT `handle_path`, because handle_path
	# would strip the /wiki prefix and riff would answer /api/...
	# instead of /wiki/api/... (every wiki route is under /wiki:
	# /wiki/api/tree, /wiki/api/pages, /wiki/static/…, /wiki/assets/…).
	#
	# This is what makes /wiki a SIBLING of /memos rather than a
	# child: the public URL is https://<host>/wiki/, not
	# https://<host>/memos/wiki/. The wiki's SPA reads its mount
	# prefix from the base-path meta tag the server renders (pb/leafwiki
	# substitutes {{__BASE_PATH__}} with the prefix it is mounted at),
	# so it builds /wiki/api/... calls and /wiki/static/... asset URLs
	# on its own — nothing here has to rewrite them.
	handle /wiki {
		redir * /wiki/ 308
	}
	handle /wiki/* {
		import proxy
	}

	# 2c. /forum/*: the forum module, mounted by riff at /forum INSIDE the
	# listener — a SIBLING of /memos, not a child of it, so the public
	# URL is https://<host>/forum/.
	#
	# Like /wiki this uses `handle`, NOT `handle_path`: the forum SPA
	# builds ABSOLUTE /forum/... URLs. pb/flarum/frontend's assetURL and
	# scriptURLs prefix every bundle with the module's base path, and the
	# boot payload hands that same base path to Flarum's router (the forum
	# document's `basePath`/`baseUrl`/`apiUrl` attributes). Stripping the
	# prefix would make riff serve /assets/forum.js instead of
	# /forum/assets/forum.js, and every bundle would 404 against the
	# static site's file_server.
	handle /forum {
		redir * /forum/ 308
	}
	handle /forum/* {
		import proxy
	}

	# 2d. PocketBase's OWN endpoints, at the host root: /_/ is the
	# dashboard (admin UI) and /api/* the REST API. They are the same
	# handlers the /memos/* prefix strip reaches at /memos/_/ and
	# /memos/api/*, served a second time unprefixed — and, importantly,
	# NOT 308'd into the SPA by the @spa rule below.
	#
	# The path is NOT rewritten. PocketBase serves both from the root of
	# its listener and knows nothing about /memos/, so stripping or
	# prefixing here would turn /api/collections into /collections and
	# PocketBase would answer with the SPA fallback — index.html with a
	# 200, which an API client parses as data.
	#
	# Without this block the @spa matcher below answered /_/ with a 308
	# to /memos/_/ and /api/health with a 308 to /memos/api/health. The
	# redirect itself is survivable, but it is not what PocketBase's own
	# docs, its first-boot install link (`.../_/#/pbinstall/<token>`) or
	# any API client assume, and a proxy (or a client that does not
	# follow a cross-path redirect on POST) breaks on it.
	#
	# This is not a new attack surface: they are the same collection
	# rules and the same superuser gate, reached by a second URL.
	handle /_ {
		import proxy
	}
	handle /_/* {
		import proxy
	}
	handle /api {
		import proxy
	}
	handle /api/* {
		import proxy
	}

	# 2e. riff's MCP endpoint, also at the host root: every editor that
	# speaks MCP is configured with `https://<host>/mcp`, and the endpoint
	# answers `/mcp/` as well (a client may normalise the URL to end in a
	# slash). Both spellings are proxied VERBATIM — the path IS the endpoint,
	# so nothing here may rewrite it.
	handle /mcp {
		import proxy
	}
	handle /mcp/* {
		import proxy
	}

	# 3. SPA-only paths: redirect to /memos/<path>. The named
	# matcher @spa excludes anything that already has a more specific
	# handler above (/memos, /memos/*) and the static site's
	# top-level paths (so a future /blog under the static site still
	# serves as itself).
	#
	# The static-site exclusion list is the set of top-level
	# directories in /var/www/site/ as of the last build of the
	# ravine Jekyll tree; if the static site adds a new top-level
	# page (e.g. /blog, /changelog), add it here or it will be
	# silently redirected to /memos/blog and the SPA will 404
	# on it. /assets is also excluded (favicon, CSS, JS for the
	# static site). / and /index.html are excluded so the homepage
	# of the static site still resolves.
	#
	# Note: the bare path `/` MUST be in the exclusion list. Without
	# it, GET / falls into @spa and gets 308'd to /memos/, which
	# sends the user to the SPA when they wanted the static site
	# homepage. /index.html was already excluded; the prior version
	# of this file listed `/` in this comment but not in the matcher,
	# which is how the regression slipped in. Keep the two in sync.
	#
	# Caddy's redir {uri} placeholder preserves the query string,
	# so /auth?redirect=%2F becomes /memos/auth?redirect=%2F.
	#
	# /wiki and /wiki/* are also excluded. The wiki's own handle blocks
	# above already catch them (Caddy evaluates handle blocks in
	# declaration order and the first match wins), so this is
	# belt-and-braces rather than the thing that makes it work — but if
	# the wiki blocks are ever moved below this one, the exclusion is
	# what keeps /wiki from being 308'd to /memos/wiki.
	#
	# /forum and /forum/* are excluded for the same reason: they are a
	# sibling module with their own handle blocks above, and a 308 to
	# /memos/forum would both lose the prefix the SPA needs and land
	# on the wrong app.
	#
	# /_ , /_/* , /api and /api/* are excluded for the same reason
	# again, and they had NO exclusion before their proxy blocks were
	# added: /_/ used to answer 308 -> /memos/_/ and /api/health 308 ->
	# /memos/api/health. Both landed on the right handler eventually, but
	# not at the URL PocketBase documents, and a client that refuses to
	# follow a redirect on POST never got there at all.
	#
	# /mcp and /mcp/* are excluded for the same reason once more: an MCP
	# client POSTs a JSON-RPC handshake to exactly the URL it was
	# configured with, and a 308 into /memos/mcp is a URL it never asked
	# for — one that a strict client will not follow with the body intact.
	@spa {
		not path / /memos /memos/* /community /community/* /wiki /wiki/* /forum /forum/* /_ /_/* /api /api/* /mcp /mcp/* /assets /assets/* /docs /docs/* /download /download/* /firmware /firmware/* /hardware /hardware/* /reader /reader/* /workflow /workflow/* /youtube /youtube/* /favicon.svg /CNAME /index.html
	}
	handle @spa {
		redir * /memos{uri} 308
	}

	# 4. /youtube/*: the user-facing download tree. A separate
	# directory from the static site, served by its own file_server, so
	# an operator can publish files for end users to download without
	# rebuilding the image (the Dockerfile creates it writable by the
	# nonroot user).
	#
	# This block MUST come before the catch-all below, or the static
	# site's file_server would answer /youtube/* first and 404 on every
	# download.
	handle /youtube/* {
		root * /youtube
		# Strip the /youtube prefix before the file lookup, or the
		# path would be resolved as /youtube/youtube/<file>. Caddy's
		# file_server joins the (unstripped) request path onto the
		# root, so the prefix has to come off first.
		uri strip_prefix /youtube
		# `browse` renders a directory listing. Without it a
		# directory with no index file answers 404 — which is what
		# an EMPTY /youtube/ did, so the download tree was
		# unreachable until it had at least one file in it.
		#
		# It is a sub-directive of file_server, NOT a standalone
		# one: a bare `browse` fails the Caddyfile parse with
		# "unrecognized directive: browse".
		file_server browse
	}

	# 5. Everything else: the static site. file_server handles
	# index.html fallbacks (so /about/ resolves to /about/index.html)
	# and Content-Type detection. 404s are intentional: a path that
	# doesn't match a file in the site tree is a real miss.
	handle {
		root * /var/www/site
		file_server
	}
}
