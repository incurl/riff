# Caddy configuration for the riff image behind a TLS-terminating edge
# proxy (Fly.io) when the host serves TWO things: the baked-in static site
# at the ROOT, and the riff SPA + Connect/gRPC surface under /community/.
#
# This is the inverse of scripts/Caddyfile.fly, which mounts riff at the
# root and treats /community/* as a back-compat alias. That layout
# assumes the operator wants riff to own the hostname; this one assumes
# the static site is the primary content and riff is one of several
# sub-apps. The two files share a common ancestor in the ACME variant
# (scripts/Caddyfile), where the host matcher picks the public DNS name
# and /community/* is a normal path-prefix reverse-proxy.
#
# Why a third file instead of inverting the existing one:
#   * scripts/Caddyfile.fly is documented in three places (its own header,
#     fly.toml, AGENTS.md) as "SPA at the root". Changing its meaning
#     would silently break that contract.
#   * Keeping a separate file makes the deploy intent explicit
#     (CADDYFILE=Caddyfile.fly.community in fly.toml) and a one-env-var
#     rollback target.
#
# Layout (all on :80 - Fly's edge terminates TLS, see fly.toml):
#
#   https://<host>/                         ->  static site at /var/www/site/
#   https://<host>/community/*              ->  riff on 127.0.0.1:8090
#                                                (prefix is stripped by
#                                                handle_path so riff sees
#                                                its normal paths)
#   https://<host>/community (no slash)     ->  308 redirect to /community/
#                                                so the SPA never boots
#                                                against a parent-only URL
#   https://<host>/<spa-path>               ->  308 to /community/<spa-path>
#                                                so a root-prefixed SPA URL
#                                                (e.g. /auth, /u/peter)
#                                                doesn't 404 against the
#                                                static site's file_server.
#                                                The query string is
#                                                preserved by the {uri}
#                                                placeholder, so a URL
#                                                like /auth?redirect=%2F
#                                                lands as
#                                                /community/auth?redirect=%2F
#                                                and the SPA picks up the
#                                                intent. {path} would lose
#                                                the query string, which is
#                                                why {uri} is the right
#                                                choice here.
#                                                Excluded are the static
#                                                site's own paths (so a
#                                                future /blog under the
#                                                static site still serves
#                                                as itself, not as a
#                                                SPA redirect) and the
#                                                /community/* tree
#                                                (covered by handle_path
#                                                below, not by this block).
#   anything else (e.g. a typo)             ->  404 (file_server misses)
#
# The riff SPA is built with VITE_BASE_PATH=/community/ pnpm release so
# the emitted asset URLs and the connect-web baseUrl resolve under
# /community/ (see web/vite.config.mts and web/src/connect.ts). The
# static site is whatever the ravine build context contains - today
# the Jekyll _site/ tree at /home/peter/CLionProjects/ravine.1une.cc.
#
# Same X-Forwarded-* contract as scripts/Caddyfile.fly: replace-and-append
# the client IP and pin X-Forwarded-Proto to https so PocketBase's
# trusted-proxy resolver, the rate limiter, the email link builder, and
# the Secure cookie flag all see the public origin.

(proxy) {
	reverse_proxy 127.0.0.1:8090 {
		header_up X-Forwarded-For "{http.request.header.X-Forwarded-For}, {remote_host}"
		header_up X-Forwarded-Proto https
	}
}

:80 {
	encode zstd gzip

	# Caddy evaluates handle blocks in declaration order; the first
	# matcher that matches wins. We declare four, in this order:
	#   1. exact /community      -> 308 to /community/, so the SPA's
	#                               relative URL resolution finds
	#                               /community/assets/... instead of
	#                               /assets/... (which would hit the
	#                               static site).
	#   2. /community/*          -> reverse_proxy to riff (prefix
	#                               stripped by handle_path).
	#   3. SPA-only paths        -> 308 to /community/<path>, so a
	#                               root-prefixed SPA URL doesn't 404
	#                               against the static site's
	#                               file_server. Excluded are paths
	#                               the static site already serves
	#                               (so a new /blog under the static
	#                               site still answers as itself, not
	#                               as a SPA redirect).
	#   4. anything else         -> file_server for the static site.
	#
	# The bare-`handle` at the end is a catch-all and is evaluated
	# only when the previous three blocks do not match. Putting
	# `redir` outside any `handle` block would be evaluated AFTER
	# the catch-all and never see the request, because file_server
	# would already have served a 404 for /community (no trailing
	# slash, no matching file in /var/www/site).

	# 1. /community (no trailing slash) -> 308 to /community/.
	handle /community {
		redir * /community/ 308
	}

	# 2. /community/* (and /community/ with the handle_path glob
	# expansion Caddy applies): reverse_proxy to riff. handle_path
	# strips the /community prefix before forwarding, so the requests
	# riff sees are its normal /, /_/, /api/health, /mcp,
	# /memos.api.v1.*, etc.
	handle_path /community/* {
		import proxy
	}

	# 3. SPA-only paths: redirect to /community/<path>. The named
	# matcher @spa excludes anything that already has a more specific
	# handler above (/community, /community/*) and the static site's
	# top-level paths (so a future /blog under the static site still
	# serves as itself).
	#
	# The static-site exclusion list is the set of top-level
	# directories in /var/www/site/ as of the last build of the
	# ravine Jekyll tree; if the static site adds a new top-level
	# page (e.g. /blog, /changelog), add it here or it will be
	# silently redirected to /community/blog and the SPA will 404
	# on it. /assets is also excluded (favicon, CSS, JS for the
	# static site). / and /index.html are excluded so the homepage
	# of the static site still resolves.
	#
	# Note: the bare path `/` MUST be in the exclusion list. Without
	# it, GET / falls into @spa and gets 308'd to /community/, which
	# sends the user to the SPA when they wanted the static site
	# homepage. /index.html was already excluded; the prior version
	# of this file listed `/` in this comment but not in the matcher,
	# which is how the regression slipped in. Keep the two in sync.
	#
	# Caddy's redir {uri} placeholder preserves the query string,
	# so /auth?redirect=%2F becomes /community/auth?redirect=%2F.
	@spa {
		not path / /community /community/* /assets /assets/* /docs /docs/* /download /download/* /firmware /firmware/* /hardware /hardware/* /reader /reader/* /workflow /workflow/* /favicon.svg /CNAME /index.html
	}
	handle @spa {
		redir * /community{uri} 308
	}

	# 4. Everything else: the static site. file_server handles
	# index.html fallbacks (so /about/ resolves to /about/index.html)
	# and Content-Type detection. 404s are intentional: a path that
	# doesn't match a file in the site tree is a real miss.
	handle {
		root * /var/www/site
		file_server
	}
}
