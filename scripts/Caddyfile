# Caddy configuration for the riff deploy image.
#
# Routing:
#   https://${SITE_DOMAIN}/memos/...       ->  the Memos SPA, on riff at
#                                             localhost:8090 (the prefix
#                                             is STRIPPED: riff serves
#                                             the SPA at its own root)
#   https://${SITE_DOMAIN}/community/...   ->  308 to /memos/... (the
#                                             prefix this layout used to
#                                             serve, kept as a redirect
#                                             so old bookmarks land)
#   https://${SITE_DOMAIN}/wiki/...        ->  the wiki module, also on
#                                             riff (a sibling of
#                                             /memos/, not a child)
#   https://${SITE_DOMAIN}/forum/...       ->  the forum module, also on
#                                             riff (a sibling of
#                                             /memos/, not a child)
#   https://${SITE_DOMAIN}/_/...          ->  the PocketBase dashboard, on
#                                             riff, path VERBATIM
#   https://${SITE_DOMAIN}/api/...        ->  the PocketBase REST API, on
#                                             riff, path VERBATIM
#   https://${SITE_DOMAIN}/youtube/...    ->  the user-facing download
#                                             tree at /youtube/
#   https://${SITE_DOMAIN}/...            ->  static site at /var/www/site/
#
# Caddy auto-issues a Let's Encrypt cert when the request host matches
# ${SITE_DOMAIN} and the request comes in over the public HTTPS port.
# For local dev with SITE_DOMAIN=localhost, Caddy serves plain HTTP on :80
# and the ACME issuer is skipped (no cert challenges against 127.0.0.1).
#
# The {$VAR:default} interpolation lets the operator override SITE_DOMAIN
# and ACME_EMAIL at runtime (compose env, fly secrets, `docker run -e`).
# Keep the defaults aligned with the host's public DNS so `fly deploy` and
# `docker compose up` work out of the box.

{
	# email Caddy uses for ACME registration when issuing certs.
	# Override with ACME_EMAIL=ops@example.com in prod.
	email {$ACME_EMAIL:ops@example.com}
}

# Match the configured SITE_DOMAIN (and any subdomain one level below, so
# www.${SITE_DOMAIN} also gets the cert). Fall back to :80 plain HTTP for
# any host that doesn't match — this is the path local dev takes.
{$SITE_DOMAIN:example.com}, *.{$SITE_DOMAIN:example.com} {
	encode zstd gzip

	# /memos/* is the Memos SPA + Connect/gRPC surface. PocketBase's
	# built-in routes (/, /_/, /api/*, /mcp) all live at the ROOT of
	# riff's listener, so the prefix has to come OFF before the request
	# reaches it — that is what `handle_path` does.
	#
	# The strip is load-bearing, not cosmetic. The SPA is built with
	# `VITE_BASE_PATH=/memos/ pnpm release`, so it emits
	# /memos/assets/index-*.js and posts Connect calls to
	# `${origin}/memos/<service>`. Without the strip, riff would answer
	# /memos/assets/index-*.js with its own SPA fallback — index.html
	# served as JavaScript — and the app would never boot.
	#
	# `/memos` with no trailing slash gets a 308 of its own: `handle_path
	# /memos/*` does not match the bare prefix, and serving the SPA from
	# a parent-only URL makes its relative URL resolution look for
	# /assets/... at the host root.
	@memosBare {
		path /memos
	}
	handle @memosBare {
		redir * /memos/ 308
	}

	handle_path /memos/* {
		reverse_proxy localhost:8090 {
			# PocketBase uses X-Forwarded-For for the client IP; pass it
			# through so the rate limiter and the SSRF guards see the
			# real address and not the caddy loopback.
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# /community/* was this layout's prefix before the SPA moved to
	# /memos/. It is a 308 rather than a second proxy: the SPA is built
	# for exactly one base path, so a request under /community/ would
	# load a shell whose asset URLs point at /memos/ — the redirect is
	# what makes an old bookmark land somewhere coherent.
	#
	# {uri} carries the query string (e.g. /community/auth?redirect=%2F),
	# which {path} would drop.
	handle /community {
		redir * /memos/ 308
	}
	# handle_path strips /community BEFORE the block runs, so {uri} is
	# already the remainder: /community/auth -> /memos/auth. A plain
	# `handle` would leave the prefix in {uri} and produce
	# /memos/community/auth.
	handle_path /community/* {
		redir * /memos{uri} 308
	}

	# /wiki/* is the wiki module, a SIBLING of /memos/ — the public
	# URL is https://<host>/wiki/, not https://<host>/memos/wiki/.
	#
	# The path is NOT rewritten: riff mounts the wiki at /wiki inside
	# its own listener (pb/leafwiki's default prefix), so the prefix
	# has to reach it. The wiki's SPA builds its own /wiki/api/... and
	# /wiki/static/... URLs from the {{__BASE_PATH__}} the server
	# renders, so nothing here has to rewrite them either.
	@wiki {
		path /wiki
		path /wiki/*
	}
	handle @wiki {
		reverse_proxy localhost:8090 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# /forum/* is the forum module, a SIBLING of /memos/ — the public
	# URL is https://<host>/forum/, not https://<host>/memos/forum/.
	#
	# The path is NOT rewritten: riff mounts the forum at /forum on its
	# own listener (RIFF_FORUM_BASE_PATH), and the SPA builds ABSOLUTE
	# /forum/... URLs — pb/flarum/frontend's assetURL and scriptURLs
	# prefix every bundle with the module's base path, and the boot shell
	# hands the same base path to Flarum's router. A handle_path that
	# stripped /forum would therefore make riff answer /assets/forum.js
	# (a 404 under the static site) instead of /forum/assets/forum.js.
	@forum {
		path /forum
		path /forum/*
	}
	handle @forum {
		reverse_proxy localhost:8090 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# PocketBase's OWN endpoints, exposed at the host root: /_/ is the
	# dashboard (admin UI) and /api/* the REST API. They are the same
	# handlers the /memos/* block above reaches through its prefix
	# strip, served a second time unprefixed.
	#
	# The path is NOT rewritten. PocketBase serves both from the root of
	# its listener and knows nothing about the /memos/ prefix, so a
	# handle_path here would turn /api/collections into /collections and
	# PocketBase would answer it with the SPA fallback — index.html with
	# a 200, which an API client parses as data.
	#
	# Why expose them at all in a /memos/ layout: this is the surface
	# PocketBase's own documentation and tooling assume. The install
	# link the server prints at first boot (`.../_/#/pbinstall/<token>`)
	# and every `curl http://<host>/api/health` in its docs are
	# root-relative, and without these blocks the static site's
	# file_server answered them with a 404. Mirroring /memos/_/ and
	# /memos/api/* on the root means an operator never has to know which
	# sub-path riff happens to be mounted on.
	#
	# This is not a new attack surface: they are the same collection
	# rules and the same superuser gate, reached by a second URL.
	@pocketbase {
		path /_
		path /_/*
		path /api
		path /api/*
	}
	handle @pocketbase {
		reverse_proxy localhost:8090 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# /youtube/* is the user-facing download tree: a separate directory
	# from the static site, served by its own file_server. It exists so
	# an operator can publish files for end users to download without
	# rebuilding the image (the directory is created writable by the
	# nonroot user in the Dockerfile).
	#
	# This block MUST come before the catch-all below, or the static
	# site's file_server would answer /youtube/* first and 404 on every
	# download.
	handle /youtube/* {
		root * /youtube
		# Strip the /youtube prefix before the file lookup, or the
		# path would be resolved as /youtube/youtube/<file>. Caddy's
		# file_server joins the (unstripped) request path onto the
		# root, so the prefix has to come off first.
		uri strip_prefix /youtube
		# `browse` renders a directory listing. Without it a
		# directory with no index file answers 404 — which is what
		# an EMPTY /youtube/ did, so the download tree was
		# unreachable until it had at least one file in it.
		#
		# It is a sub-directive of file_server, NOT a standalone
		# one: a bare `browse` fails the Caddyfile parse with
		# "unrecognized directive: browse".
		file_server browse
	}

	# Everything else: serve the static site from /var/www/site.
	# Caddy's file_server honours index.html fallbacks and Content-Type
	# detection; the Jekyll _site/ tree ships with index.html at root.
	handle {
		root * /var/www/site
		file_server
	}
}

# Fallback server for any host that doesn't match the configured
# SITE_DOMAIN (e.g. raw IP, misconfigured DNS, local dev with
# curl http://127.0.0.1). Returns 404 rather than a leaked default
# cert, so an unrelated hostname pointing at this host gets a clear
# error instead of a wrong-site cert.
:80 {
	respond 404
}
