{
  "name": "@riff/forum-frontend",
  "private": true,
  "version": "2.0.0",
  "description": "The reused Flarum frontend (Mithril + TypeScript), vendored into riff and built for the Go backend to serve.",
  "license": "MIT",
  "workspaces": [
    "packages/core",
    "packages/webpack-config",
    "packages/tsconfig",
    "packages/prettier-config"
  ],
  "scripts": {
    "build": "npm run build --workspace=@flarum/core",
    "build:dev": "npm run build --workspace=@flarum/core -- --mode development",
    "typecheck": "npm run check-typings --workspace=@flarum/core",
    "test": "npm run test --workspace=@flarum/core"
  },
  "devDependencies": {
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=20"
  }
}
